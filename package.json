{
  "name": "eric-kong-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run --bun vite --host 127.0.0.1",
    "check": "bun run --bun tsc --noEmit",
    "test": "bun test ./src/lib",
    "build": "bun run check && bun run --bun vite build",
    "preview": "bun run --bun vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "packageManager": "bun@1.3.14"
}
